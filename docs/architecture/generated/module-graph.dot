digraph StudySpotModules {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, labelloc=t, label="StudySpot backend: module dependencies generated from the code", nodesep=0.35, ranksep=0.9];
  node [shape=box, style="rounded", fontname="Helvetica", fontsize=11, color="#555555"];
  edge [color="#666666", arrowsize=0.7, fontname="Helvetica", fontsize=9];
  "accounts" [label="Accounts"];
  "adapter:audio-ai" [label="«adapter»\naudio-ai", style="rounded,dashed"];
  "adapter:email" [label="«adapter»\nemail", style="rounded,dashed"];
  "adapter:llm" [label="«adapter»\nllm", style="rounded,dashed"];
  "adapter:maps" [label="«adapter»\nmaps", style="rounded,dashed"];
  "adapter:push" [label="«adapter»\npush", style="rounded,dashed"];
  "admin" [label="Admin"];
  "audio" [label="Audio"];
  "audit" [label="Audit"];
  "conditions" [label="Conditions"];
  "configuration" [label="Configuration", color="#1f6feb", penwidth=1.6];
  "notifications" [label="Notifications"];
  "presence" [label="Presence", color="#1f6feb", penwidth=1.6];
  "qr-codes" [label="Qr Codes"];
  "rewards" [label="Rewards"];
  "scheduler" [label="Scheduler"];
  "studymatch" [label="Studymatch"];
  "surveys" [label="Surveys"];
  "venues" [label="Venues"];
  "admin" -> "accounts";
  "admin" -> "audit";
  "admin" -> "configuration";
  "audio" -> "adapter:audio-ai";
  "conditions" -> "configuration";
  "conditions" -> "presence";
  "notifications" -> "adapter:push";
  "presence" -> "configuration";
  "qr-codes" -> "presence";
  "qr-codes" -> "rewards";
  "qr-codes" -> "surveys";
  "rewards" -> "adapter:email";
  "rewards" -> "configuration";
  "rewards" -> "presence";
  "scheduler" -> "conditions";
  "scheduler" -> "presence";
  "scheduler" -> "qr-codes";
  "scheduler" -> "rewards";
  "scheduler" -> "surveys";
  "studymatch" -> "adapter:llm";
  "studymatch" -> "conditions";
  "studymatch" -> "venues";
  "surveys" -> "rewards";
  "venues" -> "accounts";
  "venues" -> "adapter:maps";
  "venues" -> "conditions";
  "venues" -> "configuration";
  "accounts" -> "audit" [style=dashed, color="#1f6feb", fontcolor="#1f6feb", label="SignInFailed"];
  "surveys" -> "conditions" [style=dotted, color="#999999", fontcolor="#999999", label="SurveyStored (planned)"];
  "audio" -> "conditions" [style=dotted, color="#999999", fontcolor="#999999", label="NoiseRecorded (planned)"];
  "admin" -> "audit" [style=dotted, color="#999999", fontcolor="#999999", label="StaffAction (planned)"];
  "presence" -> "notifications" [style=dotted, color="#999999", fontcolor="#999999", label="PresenceDwell (planned)"];
  "configuration" -> "conditions" [style=dotted, color="#999999", fontcolor="#999999", label="ConfigChanged (planned)"];
  "configuration" -> "rewards" [style=dotted, color="#999999", fontcolor="#999999", label="ConfigChanged (planned)"];
  subgraph cluster_key { label="Key"; fontsize=10; color="#cccccc";
    k1 [shape=plaintext, label="solid: uses interface   dashed blue: event emitted in code   dotted grey: event designed, emitted in a later sprint   blue box: new in SDS v0.3   (Clock, also new, is used by most modules and not drawn)"]; }
}
