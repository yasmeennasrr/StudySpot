@startuml er-diagram
' SDS v0.3: database schema (entity-relationship), from backend/src/db/entities.
' 19 tables, migration 1792946643956-InitialSchema. PK = primary key, FK = foreign key.
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam class {
  BackgroundColor white
  BorderColor #555555
}
hide circle
hide methods
skinparam ArrowColor #666666

title StudySpot database schema (SDS v0.3): 19 tables on PostgreSQL + PostGIS

package "Accounts (M2)" {
  entity users {
    * id : uuid <<PK>>
    --
    * email : varchar(254) <<unique>>
    * password_hash : varchar
    * display_name : varchar(30)
    * terms_accepted_at : timestamptz
    * role : user | admin | moderator
    * suspended : bool
    * points_balance : int >= 0
    * presence_prompts_enabled : bool
    * created_at
  }
  entity sessions {
    * id : uuid <<PK>>
    --
    * user_id <<FK>>
    * refresh_token_hash <<unique>>
    * last_used_at
    revoked_at
  }
  entity device_tokens {
    * id <<PK>>
    --
    * user_id <<FK>>
    * token <<unique>>
  }
}

package "Venues (M3, M4)" {
  entity venues {
    * id : uuid <<PK>>
    --
    * name : varchar(120) <<trigram index>>
    * location : geography(Point,4326) <<GiST>>
    address, area
    opening_hours : jsonb
    price_level : 1..4
    wifi_available, outlets_available
    study_type : individual | group | both
    * size_class : small | medium | large
    * source : team | maps
    * active : bool
  }
  entity reviews {
    * id <<PK>>
    --
    * venue_id <<FK>>
    * user_id <<FK>>
    * rating : 1..5
    text : <= 1000 chars
    removed_at
    unique(venue_id, user_id)
  }
  entity review_reports {
    * id <<PK>>
    --
    * review_id <<FK>>
    * reporter_id <<FK>>
  }
  entity user_preferences {
    * user_id <<PK, FK>>
    --
    * criteria : jsonb (FR-013)
  }
  entity favorites {
    * user_id <<PK, FK>>
    * venue_id <<PK, FK>>
  }
}

package "Conditions and contribution (Sprint 2)" {
  entity surveys {
    * id <<PK>>
    --
    * venue_id <<FK>>
    user_id <<FK, null on delete>>
    * source : qr | in_app
    crowd_answer, noise_answer, wifi_answer
    * submitted_at
    * points_awarded
    no_points_reason, removed_at
  }
  entity dynamic_records {
    * id <<PK>>
    --
    * venue_id <<FK>>
    * condition_type : crowd | noise | wifi
    * value : 1..3
    * source_type : qr_survey | in_app_survey |\n audio_analysis | present_user_count
    * recorded_at
    survey_id <<FK>>
  }
  entity presence_records {
    * id <<PK>>
    --
    * user_id <<FK>>
    * venue_id <<FK>>
    * source : location | receipt_scan
    * recorded_at (purged after 2 h)
  }
  entity receipt_codes {
    * token : varchar(32) <<PK>>
    --
    * venue_id <<FK>>
    api_key_id
    first_scan_at
    scanned_by_user_id <<FK>>
    * status : unused | scanned | used | expired
    survey_id, points_awarded
  }
  entity venue_api_keys {
    * id <<PK>>
    --
    * venue_id <<FK>>
    * key_hash <<unique>>
    * key_prefix
    revoked_at
  }
}

package "Rewards (Sprints 2-3)" {
  entity coupon_offers {
    * id <<PK>>
    --
    * venue_id <<FK>>
    * reward
    * point_cost > 0
    * active
  }
  entity coupons {
    * id <<PK>>
    --
    * code : XXXX-XXXX <<unique>>
    * offer_id <<FK>>
    * venue_id <<FK>>
    * owner_user_id <<FK>>
    * point_cost, reward
    * activation_token_hash <<unique>>
    activated_at
    * status : issued | active | expired
    * email_status : pending | sent | failed
    email_attempts, next_email_attempt_at
  }
  entity points_ledger {
    * id <<PK>>
    --
    * user_id <<FK>>
    * delta : int
    * reason : survey_award | coupon_redemption | no_award
    survey_id <<FK, one award per survey>>
    coupon_id <<FK>>
    note
  }
}

package "Platform (M1)" {
  entity audit_log {
    * id <<PK>>
    --
    * actor_type : user | staff | system | anonymous
    actor_id
    * action
    target, details : jsonb, ip
    * created_at
  }
  entity config_values {
    * key <<PK>>
    --
    * value : jsonb
    updated_by
  }
  entity config_history {
    * id <<PK>>
    --
    * key
    old_value, new_value
    * changed_by, changed_at
  }
}

users ||--o{ sessions
users ||--o{ device_tokens
users ||--o{ reviews
users ||--o| user_preferences
users ||--o{ favorites
users |o--o{ surveys
users ||--o{ presence_records
users ||--o{ coupons
users ||--o{ points_ledger
users ||--o{ review_reports
venues ||--o{ reviews
venues ||--o{ favorites
venues ||--o{ surveys
venues ||--o{ dynamic_records
venues ||--o{ presence_records
venues ||--o{ receipt_codes
venues ||--o{ venue_api_keys
venues ||--o{ coupon_offers
reviews ||--o{ review_reports
surveys |o--o{ dynamic_records
surveys |o--o| points_ledger
coupon_offers ||--o{ coupons
coupons |o--o{ points_ledger
config_values ||..o{ config_history
@enduml
