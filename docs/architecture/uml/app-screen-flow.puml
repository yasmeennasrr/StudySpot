@startuml app-screen-flow
' SDS v0.3 Section 14 (M5/M6): app screen flow, Sprint 3 (DRS feedback: logical flow, responsive).
' Routes and rules: app/lib/core/routing/router.dart (appRedirect) and app_shell.dart.
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam ArrowColor #555555
skinparam state {
  BackgroundColor white
  BorderColor #555555
  BackgroundColor<<task>> #F4F7F5
  BorderColor<<task>> #2E6B5E
}
hide empty description

title StudySpot app: screen flow (UML state machine of the navigation)

state "First launch" as Onboarding {
  state "Terms and privacy\n/terms" as Terms : PRIV-011
  state "Location purpose\n/location" as Location : PRIV-003, FR-010
  state "Are-you-here check-ins\n/presence" as Presence : SEN-013
  Terms --> Location : accept + Continue
  Location --> Presence : Allow, or type an area / Skip
}

state "Main places (AppShell)" as Shell {
  state "Explore\n/home" as Explore : FR-009..FR-015\nlist + map side by side\non a laptop
  state "Saved\n/favorites" as Saved : FR-027
  state "StudyMatch\n/studymatch" as StudyMatch : AI-001
  state "Rewards\n/rewards" as Rewards : RWD-004, RWD-005,\nRWD-021
  state "Account\n/account" as Account : FR-004, FR-005
  ' Any tab to any tab in one tap; hidden links only set the order.
  Explore -[hidden]right-> Saved
  Saved -[hidden]right-> StudyMatch
  StudyMatch -[hidden]right-> Rewards
  Rewards -[hidden]right-> Account
}

state "Place details\n/venues/:id" as Details <<task>> : FR-016..FR-021
state "Coupon at the counter\n/rewards/coupons/:id" as Coupon <<task>> : RWD-017..RWD-020
state "Sign in\n/signin" as SignIn <<task>> : FR-002, FR-003
state "Create account\n/register" as Register <<task>> : FR-001
state "Edit account / Preferences\n/account/edit, /preferences" as Settings <<task>> : FR-005, FR-022

[*] --> Terms : first launch
[*] --> Explore : terms already accepted
Presence --> Explore : Continue / Not now

Explore --> Details : tap a place or a pin
Saved --> Details
StudyMatch --> Details : a recommendation
Rewards --> Coupon : tap a coupon (after Redeem)
Account --> Settings
Account --> Location : Location settings

Shell --> SignIn : a protected tab while signed out\n(Saved, StudyMatch, Account)\nor "Sign in" on Rewards
SignIn --> Register : "New here?"
SignIn --> Shell : signed in: back to that tab
Register --> Shell : account created
Details --> Shell : back (the tab keeps its list)
Coupon --> Rewards : back
Account --> Explore : Sign out

note right of Shell
  <b>Navigation adapts to the window</b> (USE-001):
  phone: bottom navigation bar;
  tablet / laptop: navigation rail (labels from 1200 px).
  Each tab keeps its own history and scroll position.
  Pages keep a readable width on wide screens.
end note

note bottom of SignIn
  Protected (FR-007): /account, /account/edit, /preferences,
  /favorites, /studymatch, /rewards/coupons/*.
  Signed out -> /signin?from=<screen>, then back to it.
  Session expired (SEC-009): any screen -> Sign in again.
end note
@enduml
