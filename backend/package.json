{
  "name": "studyspot-backend",
  "version": "0.2.0",
  "description": "StudySpot backend: NestJS modular monolith (see docs/architecture)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest -c jest.config.json",
    "test:cov": "jest -c jest.config.json --coverage",
    "test:int": "jest --config test/jest-int.json --runInBand",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "deps:graph": "node scripts/module-graph.mjs",
    "typeorm": "typeorm-ts-node-commonjs -d src/db/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run:prod": "typeorm -d dist/db/data-source.js migration:run",
    "seed": "ts-node src/db/seed/seed.ts",
    "seed:records": "node scripts/generate-records.mjs",
    "contract:check": "node -e \"require('@apidevtools/swagger-parser').validate('../contracts/openapi.yaml').then(a=>console.log('OpenAPI valid:',Object.keys(a.paths).length,'paths')).catch(e=>{console.error(e.message);process.exit(1)})\""
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^18.0.9",
    "helmet": "^8.3.0",
    "joi": "^18.3.0",
    "js-yaml": "^5.5.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.6",
    "typescript-eslint": "^8.72.0"
  }
}
