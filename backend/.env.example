# Copy to backend/.env for local development. Never commit .env (SEC-005).
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Local: docker compose up -d db   |   Supabase: Project Settings > Database > Connection string (URI)
DATABASE_URL=postgres://studyspot:studyspot@localhost:5432/studyspot
DATABASE_SSL=false
# true = run pending migrations on startup (used on Render)
DATABASE_RUN_MIGRATIONS=false

# M2: use a long random string in Render (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
SESSION_INACTIVITY_DAYS=14
# Staff Console (PB-32): staff session length, and sign-in tries per client per minute.
STAFF_SESSION_TTL_SECONDS=900
STAFF_SIGNIN_LIMIT=5

CORS_ORIGINS=*
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
SCHEDULER_ENABLED=true

# Leave empty to use the fake adapters (offline, deterministic)
GOOGLE_GEOCODING_API_KEY=
# Give up on Google after this many ms; search then falls back (EIR-011)
GOOGLE_GEOCODING_TIMEOUT_MS=3000
GEMINI_API_KEY=
# Noise sampling (PB-19): gemini | loudness | fake. Empty = Gemini when GEMINI_API_KEY is set, else the
# offline loudness classifier. GEMINI_AUDIO_MODEL picks the model.
AUDIO_AI_PROVIDER=
GEMINI_AUDIO_MODEL=gemini-3.8-flash
# StudyMatch (PB-29): Gemini model for the chat assistant. Uses GEMINI_API_KEY above.
# On 2026-11-24 3.5-flash mostly timed out or gave 503; 3.5-flash-lite answered most questions in 1-4 s.
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high, or empty for the model's default. Higher = slower.
GEMINI_LLM_THINKING=minimal
# gemini | fake. Empty = Gemini when GEMINI_API_KEY is set, else the fake (StudyMatch shows standard results).
LLM_PROVIDER=
# PB-46 safety net (EIR-015): per-call limit, failures in a row that open the breaker, how long it stays open.
LLM_TIMEOUT_MS=5000
LLM_BREAKER_FAILURES=5
LLM_BREAKER_OPEN_MS=30000
# StudyMatch questions a minute per client (protects the Gemini quota).
STUDYMATCH_LIMIT=10
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Optional: service-account JSON for real FCM pushes; empty uses a logging fake.
FCM_SERVICE_ACCOUNT_JSON=

PUBLIC_BASE_URL=http://localhost:3000
