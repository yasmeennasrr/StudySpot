# Copy to backend/.env for local development. Never commit .env (SEC-005).
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Local: docker compose up -d db   |   Supabase: Project Settings > Database > Connection string (URI)
DATABASE_URL=postgres://studyspot:studyspot@localhost:5432/studyspot
DATABASE_SSL=false
# true = run pending migrations on startup (used on Render)
DATABASE_RUN_MIGRATIONS=false

# M2: use a long random string in Render (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
SESSION_INACTIVITY_DAYS=14

CORS_ORIGINS=*
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
SCHEDULER_ENABLED=true

# Leave empty to use the fake adapters (offline, deterministic)
GOOGLE_GEOCODING_API_KEY=
GEMINI_API_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
FCM_SERVICE_ACCOUNT_JSON=

PUBLIC_BASE_URL=http://localhost:3000
